<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 420" width="1200" height="420" role="img" aria-label="eddie. Diseño interfaces con React y Next.js. Una tarjeta de contacto donde un cursor hace clic en Escríbeme y aparece Mensaje enviado." xmlns:c2pa="http://c2pa.org/manifest">
  <defs>
    <clipPath id="round"><rect width="1200" height="420" rx="22"/></clipPath>
    <clipPath id="btn"><rect x="732" y="268" width="200" height="52" rx="26"/></clipPath>
    <pattern id="dots" width="22" height="22" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.1" fill="#FFFFFF" fill-opacity="0.14"/></pattern>
  </defs>

  <style>
    .sans { font-family: ui-sans-serif, "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif; }
    .mono { font-family: ui-monospace, "SF Mono", Consolas, "Courier New", monospace; }

    .p1 { animation: t1 13.6s linear infinite; opacity: 0; clip-path: inset(0 100% 0 0); }
    @keyframes t1 {
      0%        { opacity: 0; clip-path: inset(0 100% 0 0); animation-timing-function: step-end; }
      2.941%   { opacity: 1; clip-path: inset(0 100% 0 0); animation-timing-function: steps(18, end); }
      12.206% { opacity: 1; clip-path: inset(0 0 0 0);    animation-timing-function: step-end; }
      29.853%   { opacity: 0; clip-path: inset(0 0 0 0); }
      100%      { opacity: 0; clip-path: inset(0 100% 0 0); }
    }
    .p2 { animation: t2 13.6s linear infinite; opacity: 0; clip-path: inset(0 100% 0 0); }
    @keyframes t2 {
      0%        { opacity: 0; clip-path: inset(0 100% 0 0); animation-timing-function: step-end; }
      33.088%   { opacity: 1; clip-path: inset(0 100% 0 0); animation-timing-function: steps(29, end); }
      45.882% { opacity: 1; clip-path: inset(0 0 0 0);    animation-timing-function: step-end; }
      62.794%   { opacity: 0; clip-path: inset(0 0 0 0); }
      100%      { opacity: 0; clip-path: inset(0 100% 0 0); }
    }
    .p3 { animation: t3 13.6s linear infinite; opacity: 0; clip-path: inset(0 100% 0 0); }
    @keyframes t3 {
      0%        { opacity: 0; clip-path: inset(0 100% 0 0); animation-timing-function: step-end; }
      65.441%   { opacity: 1; clip-path: inset(0 100% 0 0); animation-timing-function: steps(21, end); }
      76.250% { opacity: 1; clip-path: inset(0 0 0 0);    animation-timing-function: step-end; }
      95.368%   { opacity: 0; clip-path: inset(0 0 0 0); }
      100%      { opacity: 0; clip-path: inset(0 100% 0 0); }
    }
    .caret-move { animation: cmove 13.6s linear infinite; }
    .caret-blink { animation: blink 1s steps(1) infinite; }
    @keyframes cmove {
      0% { transform: translateX(0px); animation-timing-function: step-end; }
      2.941% { transform: translateX(0px); animation-timing-function: steps(18, end); }
      12.206% { transform: translateX(306.0px); animation-timing-function: step-end; }
      29.853% { transform: translateX(0px); animation-timing-function: step-end; }
      33.088% { transform: translateX(0px); animation-timing-function: steps(29, end); }
      45.882% { transform: translateX(493.0px); animation-timing-function: step-end; }
      62.794% { transform: translateX(0px); animation-timing-function: step-end; }
      65.441% { transform: translateX(0px); animation-timing-function: steps(21, end); }
      76.250% { transform: translateX(357.0px); animation-timing-function: step-end; }
      95.368% { transform: translateX(0px); animation-timing-function: step-end; }
      100% { transform: translateX(0px); }
    }
    @keyframes blink { 0%,55% { opacity: 1; } 56%,100% { opacity: 0; } }

    /* tarjeta: ciclo de 8s */
    .cursor { animation: cursor 8s ease-in-out infinite; transform: translate(1100px, 380px); }
    .press  { animation: press 8s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
    .ripple { animation: ripple 8s ease-out infinite; transform-box: fill-box; transform-origin: center; opacity: 0; }
    .toast  { animation: toast 8s ease-in-out infinite; opacity: 0; }
    .pulse  { animation: pulse 2s ease-out infinite; transform-box: fill-box; transform-origin: center; }
    @keyframes cursor {
      0%   { transform: translate(1100px, 380px); }
      20%  { transform: translate(902px, 300px); }
      62%  { transform: translate(902px, 300px); }
      80%  { transform: translate(1100px, 380px); }
      100% { transform: translate(1100px, 380px); }
    }
    @keyframes press {
      0%,22% { transform: scale(1); }
      25%    { transform: scale(0.94); }
      31%,100% { transform: scale(1); }
    }
    @keyframes ripple {
      0%,23.9% { opacity: 0; transform: scale(0.1); }
      24%  { opacity: 0.38; transform: scale(0.1); }
      40%,100% { opacity: 0; transform: scale(1); }
    }
    @keyframes toast {
      0%,26% { opacity: 0; transform: translateY(14px); }
      33%,68% { opacity: 1; transform: translateY(0); }
      75%,100% { opacity: 0; transform: translateY(6px); }
    }
    @keyframes pulse { 0% { transform: scale(1); opacity: 0.55; } 100% { transform: scale(2.6); opacity: 0; } }

    @media (prefers-reduced-motion: reduce) {
      .p { animation: none; opacity: 0; clip-path: none; }
      .p1 { opacity: 1; }
      .caret-move { animation: none; transform: translateX(306.0px); }
      .caret-blink, .cursor, .press, .ripple, .pulse { animation: none; }
      .toast { animation: none; opacity: 1; }
      .cursor { transform: translate(902px, 300px); }
    }
  </style>

  <g clip-path="url(#round)">
    <rect width="1200" height="420" fill="#0A0A0A"/>
    <rect width="1200" height="420" fill="url(#dots)"/>

    <!-- nombre -->
    <text class="sans" x="48" y="232" font-size="240" font-weight="900" fill="#FFFFFF" textLength="560" lengthAdjust="spacingAndGlyphs">eddie</text>

    <!-- línea tipeada -->
    <text class="mono" x="48" y="298" font-size="28" fill="#8A8A8A">›</text>
    <text class="mono p p1" x="76" y="298" font-size="28" fill="#FFFFFF" textLength="306" lengthAdjust="spacingAndGlyphs">Diseño interfaces.</text>
    <text class="mono p p2" x="76" y="298" font-size="28" fill="#FFFFFF" textLength="493" lengthAdjust="spacingAndGlyphs">React + Next.js + TypeScript.</text>
    <text class="mono p p3" x="76" y="298" font-size="28" fill="#FFFFFF" textLength="357" lengthAdjust="spacingAndGlyphs">Si es feo, es un bug.</text>
    <g class="caret-blink"><rect class="caret-move" x="76" y="276" width="3" height="30" fill="#FFFFFF"/></g>

    <!-- stack -->
    <g class="sans" font-size="14" font-weight="600" fill="#FFFFFF" text-anchor="middle">
      <rect x="48" y="340" width="71" height="34" rx="17" fill="none" stroke="#FFFFFF" stroke-width="1.3"/><text x="83.5" y="362">React</text>
      <rect x="129" y="340" width="87" height="34" rx="17" fill="none" stroke="#FFFFFF" stroke-width="1.3"/><text x="172.5" y="362">Next.js</text>
      <rect x="226" y="340" width="110" height="34" rx="17" fill="none" stroke="#FFFFFF" stroke-width="1.3"/><text x="281.0" y="362">TypeScript</text>
      <rect x="346" y="340" width="64" height="34" rx="17" fill="none" stroke="#FFFFFF" stroke-width="1.3"/><text x="378.0" y="362">Vite</text>
      <rect x="420" y="340" width="71" height="34" rx="17" fill="none" stroke="#FFFFFF" stroke-width="1.3"/><text x="455.5" y="362">Figma</text>
      <rect x="501" y="340" width="102" height="34" rx="17" fill="none" stroke="#FFFFFF" stroke-width="1.3"/><text x="552.0" y="362">Motion UI</text>
    </g>

    <!-- tarjeta de contacto -->
    <rect x="700" y="64" width="452" height="284" rx="24" fill="#FFFFFF"/>
    <circle cx="744" cy="112" r="24" fill="#0A0A0A"/>
    <text class="sans" x="744" y="121" font-size="26" font-weight="800" fill="#FFFFFF" text-anchor="middle">e</text>
    <text class="sans" x="780" y="108" font-size="19" font-weight="700" fill="#0A0A0A">eddie</text>
    <circle class="pulse" cx="786" cy="125" r="4" fill="#0A0A0A"/>
    <circle cx="786" cy="125" r="4" fill="#0A0A0A"/>
    <text class="sans" x="798" y="130" font-size="14" fill="#5C5C5C" textLength="170" lengthAdjust="spacingAndGlyphs">Disponible para colaborar</text>
    <line x1="732" y1="160" x2="1120" y2="160" stroke="#E6E6E6"/>
    <text class="sans" x="732" y="210" font-size="40" font-weight="800" fill="#0A0A0A" textLength="262" lengthAdjust="spacingAndGlyphs">¿Colaboramos?</text>
    <text class="sans" x="732" y="240" font-size="16" fill="#555555" textLength="352" lengthAdjust="spacingAndGlyphs">Cuéntame tu idea y la convertimos en interfaz.</text>

    <g class="press">
      <rect x="732" y="268" width="200" height="52" rx="26" fill="#0A0A0A"/>
      <text class="sans" x="816" y="300" font-size="17" font-weight="700" fill="#FFFFFF" text-anchor="middle">Escríbeme</text>
      <path d="M880 294H896M890 288L896 294L890 300" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
    </g>
    <g clip-path="url(#btn)"><circle class="ripple" cx="832" cy="294" r="130" fill="#FFFFFF"/></g>

    <!-- aviso -->
    <g class="toast">
      <rect x="880" y="332" width="256" height="52" rx="26" fill="#0A0A0A" stroke="#FFFFFF" stroke-width="1.6"/>
      <circle cx="908" cy="358" r="12" fill="#FFFFFF"/>
      <path d="M902 358.5L906.5 363L914.5 354" fill="none" stroke="#0A0A0A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
      <text class="sans" x="932" y="364" font-size="16" font-weight="700" fill="#FFFFFF" textLength="184" lengthAdjust="spacingAndGlyphs">Mensaje enviado</text>
    </g>

    <!-- cursor -->
    <g class="cursor">
      <path d="M0 0V22L6 17L10 26L14 24L10 15H18Z" fill="#0A0A0A" stroke="#FFFFFF" stroke-width="1.8" stroke-linejoin="round"/>
    </g>
  </g>
  <rect x="0.5" y="0.5" width="1199" height="419" rx="21.5" fill="none" stroke="#3A3A3A"/>
